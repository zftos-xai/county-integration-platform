<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zqkj.platform.masterdata.mapper.MasterDataBatchMapper">
    <resultMap id="batchSnapshot" type="cn.zqkj.platform.masterdata.domain.model.MasterDataBatchSnapshot">
        <constructor>
            <!-- 主数据同步批次内部主键 -->
            <idArg column="id" javaType="_long"/>
            <!-- 供业务人员识别和追踪的批次编号 -->
            <arg column="batch_no" javaType="java.lang.String"/>
            <!-- 平台级或机构级的数据范围 -->
            <arg column="scope_type" javaType="cn.zqkj.platform.masterdata.domain.model.MasterDataScopeType"/>
            <!-- 机构级批次所属的稳定机构编码，平台级批次为空 -->
            <arg column="organization_code" javaType="java.lang.String"/>
            <!-- 机构级批次所属的机构展示名称，平台级批次为空 -->
            <arg column="organization_name" javaType="java.lang.String"/>
            <!-- 发起同步时选择的外部系统环境 -->
            <arg column="environment_code" javaType="cn.zqkj.platform.system.domain.model.ParameterEnvironment"/>
            <!-- 本批次同步的主数据类别 -->
            <arg column="data_category" javaType="cn.zqkj.platform.masterdata.domain.model.MasterDataCategory"/>
            <!-- 从获批接口配置解析出的数据查询交易码 -->
            <arg column="data_trade_code" javaType="java.lang.String"/>
            <!-- 可选的数据总数查询交易码，空值表示接口不支持预查总数 -->
            <arg column="count_trade_code" javaType="java.lang.String"/>
            <!-- 医院目录接口要求的可选来源类型参数 -->
            <arg column="source_type" javaType="java.lang.String"/>
            <!-- 发起批次时从已验证100-008映射固化的来源机构标识 -->
            <arg column="source_organization_id" javaType="java.lang.String"/>
            <!-- 本批次查询数据范围的起始UTC时间，空值表示不限制起点 -->
            <arg column="query_started_at" javaType="java.time.LocalDateTime"/>
            <!-- 本批次查询数据范围的结束UTC时间，空值表示不限制终点 -->
            <arg column="query_ended_at" javaType="java.time.LocalDateTime"/>
            <!-- 批次当前所处的受控生命周期状态 -->
            <arg column="batch_status" javaType="cn.zqkj.platform.masterdata.domain.model.MasterDataBatchStatus"/>
            <!-- 上游声明的记录总数，未执行或接口未提供时为空 -->
            <arg column="declared_count" javaType="java.lang.Long"/>
            <!-- 本批次实际接收的记录数 -->
            <arg column="returned_count" javaType="_long"/>
            <!-- 本批次识别出的重复记录数 -->
            <arg column="duplicate_count" javaType="_long"/>
            <!-- 本批次未通过字段校验的记录数 -->
            <arg column="invalid_count" javaType="_long"/>
            <!-- 本批次与既有数据发生业务冲突的记录数 -->
            <arg column="conflict_count" javaType="_long"/>
            <!-- 直接同步时新增的当前主数据记录数 -->
            <arg column="created_count" javaType="_long"/>
            <!-- 直接同步时更新的当前主数据记录数 -->
            <arg column="updated_count" javaType="_long"/>
            <!-- 直接同步时确认无需修改的当前主数据记录数 -->
            <arg column="unchanged_count" javaType="_long"/>
            <!-- 正式库中存在但本批次上游结果缺失的记录数 -->
            <arg column="source_missing_count" javaType="_long"/>
            <!-- 同步完成后该范围内处于有效状态的当前记录数，未完成时为空 -->
            <arg column="active_count" javaType="java.lang.Long"/>
            <!-- 批次开始访问上游的UTC时间，尚未开始时为空 -->
            <arg column="started_at" javaType="java.time.LocalDateTime"/>
            <!-- 批次成功结束或失败终止的UTC时间，处理中为空 -->
            <arg column="finished_at" javaType="java.time.LocalDateTime"/>
            <!-- 批次直接同步完成的UTC时间，未完成时为空 -->
            <arg column="completed_at" javaType="java.time.LocalDateTime"/>
            <!-- 机器可判定的失败或受控终止原因代码 -->
            <arg column="failure_code" javaType="java.lang.String"/>
            <!-- 脱敏后的失败摘要，不保存上游原始报文或患者信息 -->
            <arg column="failure_summary" javaType="java.lang.String"/>
            <!-- SQL Server并发版本，用于阻止无感知状态覆盖 -->
            <arg column="row_version" javaType="_byte[]"/>
        </constructor>
    </resultMap>

    <resultMap id="directorySyncResult" type="cn.zqkj.platform.masterdata.domain.model.HospitalDirectorySyncResult">
        <constructor>
            <!-- 100-003目录类型 -->
            <arg column="directory_type" javaType="cn.zqkj.platform.his.domain.model.HospitalDirectoryType"/>
            <!-- 本类型可确认处理结论 -->
            <arg column="status" javaType="cn.zqkj.platform.masterdata.domain.model.HospitalDirectorySyncResultStatus"/>
            <!-- HIS实际返回记录数 -->
            <arg column="returned_count" javaType="_long"/>
            <!-- 批次内重复记录数 -->
            <arg column="duplicate_count" javaType="_long"/>
            <!-- 自动校验不通过记录数 -->
            <arg column="invalid_count" javaType="_long"/>
            <!-- 同来源编码冲突记录数 -->
            <arg column="conflict_count" javaType="_long"/>
            <!-- 新增当前目录记录数 -->
            <arg column="created_count" javaType="_long"/>
            <!-- 更新或恢复有效记录数 -->
            <arg column="updated_count" javaType="_long"/>
            <!-- 与当前记录一致的记录数 -->
            <arg column="unchanged_count" javaType="_long"/>
            <!-- 来源缺失并标记无效记录数 -->
            <arg column="source_missing_count" javaType="_long"/>
            <!-- 处理后当前有效记录数，未完成时为空 -->
            <arg column="active_count" javaType="java.lang.Long"/>
            <!-- 受控失败摘要，完成时为空 -->
            <arg column="failure_summary" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="batchColumns">
        batches.id,                            <!-- 主数据同步批次内部主键 -->
        batches.batch_no,                      <!-- 供业务人员识别和追踪的批次编号 -->
        batches.scope_type,                    <!-- 平台级或机构级的数据范围 -->
        organizations.organization_code,      <!-- 机构级批次所属机构编码，平台级批次为空 -->
        organizations.organization_name,      <!-- 机构级批次所属机构名称，平台级批次为空 -->
        batches.environment_code,              <!-- 发起同步时选择的外部系统环境 -->
        batches.data_category,                 <!-- 本批次同步的主数据类别 -->
        batches.data_trade_code,               <!-- 数据查询交易码 -->
        batches.count_trade_code,              <!-- 可选总数查询交易码，不支持预查时为空 -->
        batches.source_type,                   <!-- 医院目录接口要求的可选来源类型 -->
        batches.source_organization_id,        <!-- 已验证来源机构标识的批次快照 -->
        batches.query_started_at,              <!-- 查询范围起始UTC时间，不限起点时为空 -->
        batches.query_ended_at,                <!-- 查询范围结束UTC时间，不限终点时为空 -->
        batches.batch_status,                  <!-- 批次当前生命周期状态 -->
        batches.declared_count,                <!-- 上游声明总数，接口未提供时为空 -->
        batches.returned_count,                <!-- 实际接收记录数 -->
        batches.duplicate_count,               <!-- 重复记录数 -->
        batches.invalid_count,                 <!-- 未通过字段校验的记录数 -->
        batches.conflict_count,                <!-- 与既有数据发生业务冲突的记录数 -->
        batches.created_count,                 <!-- 直接同步时新增的当前记录数 -->
        batches.updated_count,                 <!-- 直接同步时更新的当前记录数 -->
        batches.unchanged_count,               <!-- 直接同步时确认无需修改的当前记录数 -->
        batches.source_missing_count,          <!-- 正式库存在但本批次上游缺失的记录数 -->
        batches.active_count,                  <!-- 同步完成后的有效记录数，未完成时为空 -->
        batches.started_at,                    <!-- 开始访问上游的UTC时间，未开始时为空 -->
        batches.finished_at,                   <!-- 成功或失败结束的UTC时间，处理中为空 -->
        batches.completed_at,                  <!-- 直接同步完成的UTC时间，未完成时为空 -->
        batches.failure_code,                  <!-- 失败或受控终止原因代码 -->
        batches.failure_summary,               <!-- 脱敏失败摘要，不保存原始报文或患者信息 -->
        batches.row_version                    <!-- SQL Server并发版本 -->
    </sql>

    <sql id="visibleBatchConditions">
        <!-- 平台批次全部可见；机构批次必须落在当前用户获批机构范围内 -->
        WHERE (
            batches.scope_type = 'PLATFORM'
            <if test="organizationCodes != null and !organizationCodes.isEmpty()">
                OR organizations.organization_code IN
                <foreach collection="organizationCodes" item="code" open="(" separator="," close=")">
                    #{code}
                </foreach>
            </if>
        )
        <if test="query.organizationCode != null">
            <!-- 可选按稳定机构编码精确筛选 -->
            AND organizations.organization_code = #{query.organizationCode}
        </if>
        <if test="query.requestKey != null">
            <!-- 可选按调用方幂等请求标识精确筛选 -->
            AND batches.request_key = #{query.requestKey}
        </if>
        <if test="query.category != null">
            <!-- 可选按主数据类别筛选 -->
            AND batches.data_category = #{query.category}
        </if>
        <if test="query.status != null">
            <!-- 可选按批次生命周期状态筛选 -->
            AND batches.batch_status = #{query.status}
        </if>
        <if test="query.startedFrom != null">
            <!-- 起始边界使用批次开始访问上游的UTC时间，包含边界 -->
            AND batches.started_at &gt;= #{query.startedFrom}
        </if>
        <if test="query.startedTo != null">
            <!-- 结束边界使用批次开始访问上游的UTC时间，包含边界 -->
            AND batches.started_at &lt;= #{query.startedTo}
        </if>
    </sql>

    <select id="findEnabledOrganizationId" resultType="long">
        <!-- 仅解析当前启用机构的内部主键，避免为停用机构创建同步批次 -->
        SELECT id
        FROM org_organization
        WHERE organization_code = #{organizationCode}
          AND is_enabled = 1
    </select>

    <select id="create" resultType="long" affectData="true">
        INSERT INTO md_sync_batch (
            batch_no,              <!-- 供业务人员识别和追踪的批次编号 -->
            request_key,           <!-- 调用方幂等请求标识 -->
            source_system_code,    <!-- 主数据来源系统稳定代码 -->
            scope_type,            <!-- 平台级或机构级的数据范围 -->
            organization_id,       <!-- 机构级批次所属机构主键，平台级批次为空 -->
            environment_code,      <!-- 发起同步时选择的外部系统环境 -->
            data_category,         <!-- 本批次同步的主数据类别 -->
            source_type,           <!-- 医院目录接口要求的可选来源类型 -->
            source_organization_id,<!-- 已验证来源机构标识的批次快照 -->
            query_started_at,      <!-- 查询范围起始UTC时间，不限起点时为空 -->
            query_ended_at,        <!-- 查询范围结束UTC时间，不限终点时为空 -->
            diagnosis_category,    <!-- 诊断目录分类，非诊断批次为空 -->
            diagnosis_version,     <!-- 诊断目录版本，非诊断批次为空 -->
            data_trade_code,       <!-- 数据查询交易码 -->
            count_trade_code,      <!-- 可选总数查询交易码，不支持预查时为空 -->
            batch_status,          <!-- 新批次初始生命周期状态 -->
            is_active,             <!-- 是否占用同范围活动批次唯一位置 -->
            created_by,            <!-- 创建人稳定用户标识快照 -->
            updated_by             <!-- 最后修改人稳定用户标识快照 -->
        ) VALUES (
            #{batchNo}, #{requestKey}, #{sourceSystemCode}, #{scopeType}, #{organizationId,jdbcType=BIGINT}, #{environment},
            #{category}, #{sourceType,jdbcType=NVARCHAR}, #{sourceOrganizationId,jdbcType=NVARCHAR},
            #{rangeStart,jdbcType=TIMESTAMP},
            #{rangeEnd,jdbcType=TIMESTAMP}, #{diagnosisCategory,jdbcType=NVARCHAR},
            #{diagnosisVersion,jdbcType=NVARCHAR}, #{dataTradeCode}, #{countTradeCode,jdbcType=NVARCHAR},
            'CREATED', 1, #{actor}, #{actor}
        );
        SELECT CONVERT(BIGINT, SCOPE_IDENTITY());
    </select>

    <select id="findById" resultMap="batchSnapshot">
        <!-- 按批次内部主键读取批次及可选机构展示信息 -->
        SELECT <include refid="batchColumns"/>
        FROM md_sync_batch batches
        LEFT JOIN org_organization organizations ON organizations.id = batches.organization_id
        WHERE batches.id = #{id}
    </select>

    <select id="findDirectoryResults" resultMap="directorySyncResult">
        <!-- 仅读取已保存的分项事实；不触发HIS调用，也不根据批次总计推算缺失类型。 -->
        SELECT CASE directory_type
                   WHEN 0 THEN 'DEPARTMENT' WHEN 1 THEN 'DOCTOR' WHEN 2 THEN 'WARD' WHEN 3 THEN 'BED'
               END AS directory_type,
               outcome_status AS status, returned_count, duplicate_count, invalid_count,
               conflict_count, created_count, updated_count, unchanged_count, source_missing_count,
               active_count, failure_summary
        FROM md_hospital_directory_sync_result
        WHERE batch_id = #{batchId}
        ORDER BY directory_type ASC
    </select>

    <update id="cancel">
        <!-- 只允许取消尚未执行且版本未变化的批次；历史记录保留用于审计，不做物理删除 -->
        UPDATE md_sync_batch
        SET batch_status = 'FAILED',
            is_active = 0,
            finished_at = SYSUTCDATETIME(),
            failure_code = 'CANCELLED_BY_USER',
            failure_summary = N'本批次已由业务人员取消，未调用来源HIS。',
            updated_by = #{actor},
            updated_at = SYSUTCDATETIME()
        WHERE id = #{id}
          AND row_version = #{expectedVersion}
          AND batch_status = 'CREATED'
    </update>

    <select id="countPage" resultType="long">
        <!-- 使用与分页列表一致的权限范围和业务筛选条件统计总数 -->
        SELECT COUNT(1)
        FROM md_sync_batch batches
        LEFT JOIN org_organization organizations ON organizations.id = batches.organization_id
        <include refid="visibleBatchConditions"/>
    </select>

    <select id="findPage" resultMap="batchSnapshot">
        <!-- 按创建UTC时间和内部主键倒序稳定分页 -->
        SELECT <include refid="batchColumns"/>
        FROM md_sync_batch batches
        LEFT JOIN org_organization organizations ON organizations.id = batches.organization_id
        <include refid="visibleBatchConditions"/>
        ORDER BY batches.created_at DESC, batches.id DESC
        OFFSET #{query.offset} ROWS FETCH NEXT #{query.pageSize} ROWS ONLY
    </select>
</mapper>
