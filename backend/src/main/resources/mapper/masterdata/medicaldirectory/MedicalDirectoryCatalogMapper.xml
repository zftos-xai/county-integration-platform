<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zqkj.platform.masterdata.mapper.medicaldirectory.MedicalDirectoryCatalogMapper">
    <resultMap id="medicalDirectoryRecord" type="cn.zqkj.platform.masterdata.domain.medicaldirectory.model.MedicalDirectoryRecord">
        <constructor>
            <!-- 平台医疗目录内部主键 -->
            <idArg column="id" javaType="_long"/>
            <!-- 目录归属的平台机构编码 -->
            <arg column="organization_code" javaType="java.lang.String"/>
            <!-- 目录归属的平台机构名称 -->
            <arg column="organization_name" javaType="java.lang.String"/>
            <!-- 由100-004类型代码转换后的业务分类 -->
            <arg column="directory_type" javaType="cn.zqkj.platform.masterdata.domain.medicaldirectory.model.MedicalDirectoryType"/>
            <!-- HIS提供的稳定目录编码 -->
            <arg column="source_record_code" javaType="java.lang.String"/>
            <!-- HIS提供的目录名称 -->
            <arg column="source_record_name" javaType="java.lang.String"/>
            <!-- HIS提供的可选助记码 -->
            <arg column="mnemonic_code" javaType="java.lang.String"/>
            <!-- HIS提供的目录类别名称 -->
            <arg column="category_name" javaType="java.lang.String"/>
            <!-- HIS提供的可选单位 -->
            <arg column="unit" javaType="java.lang.String"/>
            <!-- HIS提供的可选规格 -->
            <arg column="specification" javaType="java.lang.String"/>
            <!-- HIS提供的可选生产厂家 -->
            <arg column="manufacturer_name" javaType="java.lang.String"/>
            <!-- HIS原样返回的启用标记，不等同于平台有效状态 -->
            <arg column="source_enabled_flag" javaType="java.lang.String"/>
            <!-- HIS原样返回的创建时间文本 -->
            <arg column="source_created_at" javaType="java.lang.String"/>
            <!-- HIS返回的剂型，可为空 -->
            <arg column="dosage_form" javaType="java.lang.String"/>
            <!-- HIS返回的非敏感备注，可为空 -->
            <arg column="remark" javaType="java.lang.String"/>
            <!-- HIS返回的包装单位，可为空 -->
            <arg column="package_unit" javaType="java.lang.String"/>
            <!-- HIS返回的转换系数原文，可为空 -->
            <arg column="conversion_factor" javaType="java.lang.String"/>
            <!-- HIS返回的国药准字号，可为空 -->
            <arg column="approval_number" javaType="java.lang.String"/>
            <!-- HIS返回的药品本位码，可为空 -->
            <arg column="standard_code" javaType="java.lang.String"/>
            <!-- HIS返回的包装材质，可为空 -->
            <arg column="package_material" javaType="java.lang.String"/>
            <!-- HIS返回的炮制方法，可为空 -->
            <arg column="processing_method" javaType="java.lang.String"/>
            <!-- HIS返回的地区，可为空 -->
            <arg column="region" javaType="java.lang.String"/>
            <!-- HIS单独返回的类别，不与目录类别名称合并 -->
            <arg column="category" javaType="java.lang.String"/>
            <!-- 最近一次写入当前目录的批次主键 -->
            <arg column="latest_batch_id" javaType="_long"/>
            <!-- 最近一次写入当前目录的批次编号 -->
            <arg column="latest_batch_no" javaType="java.lang.String"/>
            <!-- 最近调用100-004实际使用的HIS机构参数 -->
            <arg column="source_organization_id" javaType="java.lang.String"/>
            <!-- 最近一次在成功响应中观察到本记录的UTC时间 -->
            <arg column="last_seen_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="medicalDirectoryTypeCount" type="cn.zqkj.platform.masterdata.domain.medicaldirectory.vo.MedicalDirectoryCountVO">
        <constructor>
            <!-- 由100-004类型代码转换后的业务分类 -->
            <arg column="directory_type" javaType="cn.zqkj.platform.masterdata.domain.medicaldirectory.model.MedicalDirectoryType"/>
            <!-- 当前机构范围内该类型的有效记录总数 -->
            <arg column="total" javaType="_long"/>
        </constructor>
    </resultMap>

    <sql id="visibleDirectoryConditions">
        <!-- 目录只允许调用方给定的机构范围；当前页面不展示已失效数据。 -->
        WHERE 1 = 0
        <if test="organizationCodes != null and !organizationCodes.isEmpty()">
            OR organizations.organization_code IN
            <foreach collection="organizationCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        <if test="query != null and query.organizationCode != null">
            AND organizations.organization_code = #{query.organizationCode}
        </if>
        AND directory.is_valid = 1
        <if test="query != null and query.directoryType != null">
            AND directory.directory_type = #{query.directoryType.code}
        </if>
        <if test="query != null and query.keyword != null">
            AND (directory.source_record_code LIKE '%' + #{query.keyword} + '%'
                OR directory.source_record_name LIKE '%' + #{query.keyword} + '%'
                OR directory.mnemonic_code LIKE '%' + #{query.keyword} + '%')
        </if>
        <if test="query != null and query.sourceEnabledFlag != null">
            AND directory.source_enabled_flag = #{query.sourceEnabledFlag}
        </if>
    </sql>

    <sql id="directoryColumns">
        directory.id,                           <!-- 平台医疗目录内部主键 -->
        organizations.organization_code,        <!-- 目录归属的平台机构编码 -->
        organizations.organization_name,        <!-- 目录归属的平台机构名称 -->
        CASE directory.directory_type
            WHEN '0' THEN 'TRADITIONAL_MEDICINE'
            WHEN '1' THEN 'WESTERN_MEDICINE'
            WHEN '2' THEN 'TREATMENT'
            WHEN '3' THEN 'CONSUMABLE'
        END AS directory_type,                  <!-- 由100-004代码转换后的医疗目录类型 -->
        directory.source_record_code,            <!-- HIS稳定目录编码 -->
        directory.source_record_name,            <!-- HIS目录名称 -->
        directory.mnemonic_code,                 <!-- HIS可选助记码 -->
        directory.category_name,                 <!-- HIS目录类别名称 -->
        directory.unit,                          <!-- HIS可选单位 -->
        directory.specification,                 <!-- HIS可选规格 -->
        directory.manufacturer_name,             <!-- HIS可选生产厂家 -->
        directory.source_enabled_flag,           <!-- HIS启用原始值 -->
        directory.source_created_at,             <!-- HIS创建时间原文 -->
        directory.dosage_form,                   <!-- 来源剂型 -->
        directory.remark,                        <!-- 来源备注 -->
        directory.package_unit,                  <!-- 来源包装单位 -->
        directory.conversion_factor,             <!-- 来源转换系数原文 -->
        directory.approval_number,               <!-- 来源国药准字号 -->
        directory.standard_code,                 <!-- 来源药品本位码 -->
        directory.package_material,              <!-- 来源包装材质 -->
        directory.processing_method,             <!-- 来源炮制方法 -->
        directory.region,                        <!-- 来源地区 -->
        directory.category,                      <!-- 来源类别 -->
        directory.latest_batch_id,               <!-- 最近成功同步批次主键 -->
        batches.batch_no AS latest_batch_no,     <!-- 最近成功同步批次编号 -->
        batches.source_organization_id,          <!-- 最近调用实际使用的HIS来源机构参数 -->
        directory.last_seen_at                   <!-- 最近成功同步观察时间 -->
    </sql>

    <select id="countPage" resultType="long">
        <!-- 使用与列表相同的机构范围和筛选统计当前有效医疗目录。 -->
        SELECT COUNT(1)
        FROM md_medical_directory directory
        INNER JOIN org_organization organizations ON organizations.id = directory.organization_id
        <include refid="visibleDirectoryConditions"/>
    </select>

    <select id="findPage" resultMap="medicalDirectoryRecord">
        <!-- 以类型、名称、稳定编码排序，保证分页顺序可复核。 -->
        SELECT <include refid="directoryColumns"/>
        FROM md_medical_directory directory
        INNER JOIN org_organization organizations ON organizations.id = directory.organization_id
        INNER JOIN md_sync_batch batches ON batches.id = directory.latest_batch_id
        <include refid="visibleDirectoryConditions"/>
        ORDER BY directory.directory_type, directory.source_record_name, directory.source_record_code, directory.id
        OFFSET #{query.offset} ROWS FETCH NEXT #{query.pageSize} ROWS ONLY
    </select>

    <select id="countByType" resultMap="medicalDirectoryTypeCount">
        <!-- 数量卡片仅统计当前有效目录，不受关键词和当前类型筛选影响。 -->
        SELECT CASE directory.directory_type
                   WHEN '0' THEN 'TRADITIONAL_MEDICINE'
                   WHEN '1' THEN 'WESTERN_MEDICINE'
                   WHEN '2' THEN 'TREATMENT'
                   WHEN '3' THEN 'CONSUMABLE'
               END AS directory_type,
               COUNT(1) AS total
        FROM md_medical_directory directory
        INNER JOIN org_organization organizations ON organizations.id = directory.organization_id
        WHERE 1 = 0
        <if test="organizationCodes != null and !organizationCodes.isEmpty()">
            OR organizations.organization_code IN
            <foreach collection="organizationCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        <if test="organizationCode != null">
            AND organizations.organization_code = #{organizationCode}
        </if>
        AND directory.is_valid = 1
        GROUP BY directory.directory_type
        ORDER BY directory.directory_type
    </select>
</mapper>
