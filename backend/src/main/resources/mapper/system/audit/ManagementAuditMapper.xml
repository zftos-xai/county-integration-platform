<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zqkj.platform.system.audit.mapper.ManagementAuditMapper">
    <resultMap id="managementAuditEvent" type="cn.zqkj.platform.system.audit.domain.model.ManagementAuditEvent">
        <constructor>
            <!-- 管理审计事件内部主键 -->
            <arg column="id" javaType="_long"/>
            <!-- 管理操作发生的UTC时间 -->
            <arg column="occurred_at" javaType="java.time.LocalDateTime"/>
            <!-- 操作人的平台用户主键，系统操作或身份无法解析时为空 -->
            <arg column="actor_user_id" javaType="java.lang.Long"/>
            <!-- 操作发生时的登录名快照，避免账号后续变更影响追溯 -->
            <arg column="actor_login_snapshot" javaType="java.lang.String"/>
            <!-- 操作所属机构内部主键，平台级操作时为空 -->
            <arg column="organization_id" javaType="java.lang.Long"/>
            <!-- 操作发生时的机构编码快照，平台级操作时为空 -->
            <arg column="organization_code_snapshot" javaType="java.lang.String"/>
            <!-- 稳定的管理动作代码 -->
            <arg column="action_code" javaType="java.lang.String"/>
            <!-- 被操作对象的稳定类型代码 -->
            <arg column="target_type" javaType="java.lang.String"/>
            <!-- 被操作对象的脱敏稳定标识 -->
            <arg column="target_id" javaType="java.lang.String"/>
            <!-- 操作结果代码，用于区分成功、拒绝和失败 -->
            <arg column="result_code" javaType="java.lang.String"/>
            <!-- 不包含凭证及敏感正文的变更摘要 -->
            <arg column="change_summary" javaType="java.lang.String"/>
            <!-- 贯穿一次请求的追踪编号 -->
            <arg column="request_id" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="insert" resultType="long" affectData="true">
        INSERT INTO audit_management_event
            (actor_user_id,             <!-- 操作人平台用户主键，系统操作时为空 -->
             actor_login_snapshot,      <!-- 操作发生时的登录名快照 -->
             organization_id,           <!-- 操作所属机构主键，平台级操作时为空 -->
             organization_code_snapshot,<!-- 操作发生时的机构编码快照 -->
             action_code,               <!-- 稳定管理动作代码 -->
             target_type,               <!-- 被操作对象稳定类型代码 -->
             target_id,                 <!-- 被操作对象的脱敏稳定标识 -->
             result_code,               <!-- 成功、拒绝或失败结果代码 -->
             change_summary,            <!-- 不包含凭证及敏感正文的变更摘要 -->
             request_id)                <!-- 贯穿一次请求的追踪编号 -->
        VALUES
            (#{actorUserId,jdbcType=BIGINT}, #{actorLogin,jdbcType=NVARCHAR},
             #{organizationId}, #{organizationCode}, #{actionCode}, #{targetType}, #{targetId},
             #{resultCode}, #{changeSummary}, #{requestId});
        SELECT CONVERT(BIGINT, SCOPE_IDENTITY());
    </select>

    <select id="findVisible" resultMap="managementAuditEvent">
        <!-- 查询条数由服务端限制；平台级事件及获批机构范围内事件可见 -->
        SELECT TOP (#{query.limit}) id, occurred_at, actor_user_id, actor_login_snapshot, organization_id,
               organization_code_snapshot, action_code, target_type, target_id, result_code,
               change_summary, request_id
        FROM audit_management_event
        WHERE (organization_code_snapshot IS NULL
            <if test="organizationCodes != null and !organizationCodes.isEmpty()">
                OR organization_code_snapshot IN
                <foreach collection="organizationCodes" item="code" open="(" separator="," close=")">#{code}</foreach>
            </if>
        )
        <if test="query.actorLogin != null">AND actor_login_snapshot = #{query.actorLogin}</if>
        <!-- 以下条件均为管理审计查询的可选精确筛选项 -->
        <if test="query.actionCode != null">AND action_code = #{query.actionCode}</if>
        <if test="query.targetType != null">AND target_type = #{query.targetType}</if>
        <if test="query.targetId != null">AND target_id = #{query.targetId}</if>
        <if test="query.requestId != null">AND request_id = #{query.requestId}</if>
        <if test="query.resultCode != null">AND result_code = #{query.resultCode}</if>
        <if test="query.occurredFrom != null">AND occurred_at &gt;= #{query.occurredFrom}</if>
        <if test="query.occurredTo != null">AND occurred_at &lt;= #{query.occurredTo}</if>
        <if test="query.beforeOccurredAt != null">
            <!-- 使用UTC发生时间和内部主键组成稳定的游标边界 -->
            AND (occurred_at &lt; #{query.beforeOccurredAt}
                OR (occurred_at = #{query.beforeOccurredAt} AND id &lt; #{query.beforeId}))
        </if>
        ORDER BY occurred_at DESC, id DESC
    </select>
</mapper>
