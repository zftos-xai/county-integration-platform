PLATFORM_DB_URL=jdbc:sqlserver://sqlserver2012.internal:1433;databaseName=county_integration;encrypt=true;trustServerCertificate=true
PLATFORM_DB_USERNAME=platform_app
PLATFORM_DB_PASSWORD=REPLACE_WITH_SECRET
PLATFORM_DB_MIGRATION_USERNAME=platform_migration
PLATFORM_DB_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_SECRET
PLATFORM_DB_MIGRATION_ENABLED=true
PLATFORM_BOOTSTRAP_SECRET=REPLACE_WITH_ONE_TIME_RANDOM_SECRET_AT_LEAST_32_CHARS
PLATFORM_SESSION_TIMEOUT=30m
PLATFORM_SESSION_COOKIE_SECURE=false
PLATFORM_SERVER_PORT=8080
