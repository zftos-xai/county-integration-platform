# Copy this file to deploy/.env.dev.local and set the development DB credentials and local trust-store password.
# This profile is only for the approved local development SQL Server instance.
PLATFORM_ENVIRONMENT=development
PLATFORM_DB_URL="jdbc:sqlserver://192.168.110.150:1433;databaseName=county_integration;encrypt=true;trustServerCertificate=false;sslProtocol=TLSv1.2;hostNameInCertificate=WIN-U6PMQ99S3FI;trustStore=/absolute/path/to/sqlserver-truststore.p12;trustStorePassword=REPLACE_WITH_LOCAL_TRUSTSTORE_PASSWORD;trustStoreType=PKCS12;loginTimeout=5"
PLATFORM_DB_USERNAME=sa
PLATFORM_DB_PASSWORD=REPLACE_WITH_DEVELOPMENT_DB_SECRET
PLATFORM_DB_MIGRATION_USERNAME=platform_migration
PLATFORM_DB_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_DEVELOPMENT_MIGRATION_SECRET
PLATFORM_DB_MIGRATION_ENABLED=false
PLATFORM_BOOTSTRAP_SECRET=
# 生产环境必须由安全渠道独立提供；本地启动脚本在未设置时自动生成仅供当前开发机使用的密钥文件。
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=
PLATFORM_SESSION_TIMEOUT=30m
PLATFORM_SESSION_COOKIE_SECURE=false
PLATFORM_SERVER_PORT=18080
