# Copy this file to deploy/.env.dev.local and obtain the three database passwords through a secure channel.
# This profile is only for the development SQL Server exposed through FRP on 127.0.0.1:14330.
PLATFORM_ENVIRONMENT=development
PLATFORM_DB_URL="jdbc:sqlserver://127.0.0.1:14330;databaseName=county_integration;encrypt=true;trustServerCertificate=true;sslProtocol=TLSv1;loginTimeout=5"
PLATFORM_DB_USERNAME=platform_app
PLATFORM_DB_PASSWORD=REPLACE_WITH_DEVELOPMENT_APP_SECRET
PLATFORM_DB_MIGRATION_USERNAME=platform_migration
PLATFORM_DB_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_DEVELOPMENT_MIGRATION_SECRET
PLATFORM_DB_MIGRATION_ENABLED=false
PLATFORM_BOOTSTRAP_SECRET=
# 生产环境必须由安全渠道独立提供；本地启动脚本在未设置时自动生成仅供当前开发机使用的密钥文件。
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=
PLATFORM_SESSION_TIMEOUT=30m
PLATFORM_SESSION_COOKIE_SECURE=false
PLATFORM_SERVER_PORT=18080
